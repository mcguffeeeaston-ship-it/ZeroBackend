# Zero Backend Environment Configuration
PORT=3551
MONGODB=mongodb://127.0.0.1:27017/zerobackend

# Dedicated Gameserver Configuration
GAMESERVER_IP=127.0.0.1
GAMESERVER_PORT=7777
REGION=NAE
PLAYLIST=Playlist_DefaultSolo
CLIENT_VERSION=++Fortnite+Release-11.50-CL-11603517-Windows

# XMPP Configuration
XMPP_PORT=5222
XMPP_DOMAIN=zero.local

# Discord Webhook & Bot Integration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3551/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# Discord Pings & Notifications
DISCORD_STARTUP_PING=@here
DISCORD_SHOP_WEBHOOK_URL=
DISCORD_SHOP_PING=@here

# Item Shop Auto-Rotation
USE_AUTO_ROTATE=true
ROTATE_TIME=00:00
DAILY_ITEMS_AMOUNT=6
FEATURED_ITEMS_AMOUNT=2
